# Keep Unix line endings for anything bash/zsh/vim/tmux reads, even on Windows checkouts
# (CRLF in ubuntu-setup.sh fails with "/bin/bash^M: bad interpreter")
*.sh            text eol=lf
.tmux.conf      text eol=lf
.vimrc          text eol=lf
.zshrc.*        text eol=lf
*.vim           text eol=lf
*.json          text eol=lf

# Windows scripts expect CRLF
*.bat           text eol=crlf
*.ps1           text eol=crlf
